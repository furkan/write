# Settings for the pilot (`bun run preview`, Access mode), read by deploy/write-pilot.service
# through EnvironmentFile=. Copy it to /etc/write-pilot/pilot.env, fill in the <...> values,
# then check it with `bun run pilot:check /etc/write-pilot/pilot.env`.
# Every variable is described in ../.env.example.
#
# systemd's EnvironmentFile= format: one KEY=value per line, no `export`, no ${...} expansion.

# Loopback only: the pilot is reached through cloudflared and Access, never over Tailscale or the LAN.
WRITE_HOST=127.0.0.1

# Kept apart from the dev server (5173/1234) and from a plain `bun run preview` (4173/1234), so all
# of them can run on one machine. cloudflared points at http://127.0.0.1:<WRITE_PORT>.
WRITE_PORT=4174
WRITE_COLLAB_PORT=1235

# The pilot's own documents and daily snapshots. /var/lib/write-pilot is the unit's
# StateDirectory=, created by systemd and owned by the service user.
WRITE_DATA_DIR=/var/lib/write-pilot/data
WRITE_BACKUP_DIR=/var/lib/write-pilot/backups

# The Access application's public hostname. cloudflared passes it through as the Host header,
# which Vite accepts only when it is listed here.
WRITE_ALLOWED_HOSTS=<write.example.com>

# From Cloudflare Zero Trust: the team domain (Settings > Custom Pages, or the login page's
# host name) and the Access application's "Application Audience (AUD) Tag".
WRITE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
WRITE_ACCESS_AUD=<64-hex-character AUD tag>

# Who owns documents that predate ownership. The pilot starts empty, so this only matters if a
# version-1 data dir is copied in; set it to your own Access email anyway.
WRITE_OWNER_EMAIL=<you@example.com>

# Do not set these in the pilot:
# - WRITE_ACCESS_CERTS_URL: for tests only, it makes the server trust other signing keys.
# - WRITE_ALLOWED_ORIGINS: not needed, because cloudflared keeps the browser's Host header.

# Plain log lines in the journal.
NO_COLOR=1
