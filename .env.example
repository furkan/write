# Write server settings. All are optional in Dev mode (`bun dev`).
# `bun run preview` is always Access mode and refuses to start without
# WRITE_ACCESS_TEAM_DOMAIN and WRITE_ACCESS_AUD.
#
# Values come from the environment (the pilot's systemd unit: EnvironmentFile=/path/to/this file)
# or from a `.env.local` file next to package.json (gitignored). The environment wins.

# Address the app binds to. Default: 0.0.0.0 in dev (reachable over Tailscale),
# 127.0.0.1 in preview (only cloudflared can reach the pilot).
# WRITE_HOST=127.0.0.1

# App port. Default: 5173 in dev, 4173 in preview. Startup fails if it is taken.
# WRITE_PORT=4173

# Hocuspocus port, always on 127.0.0.1. Default 1234. Give the pilot its own when it shares a
# machine with the dev server; startup fails with a clear error if it is taken.
# WRITE_COLLAB_PORT=1235

# Documents and their index. Relative paths are relative to the project root. Default ./.collab-data
# WRITE_DATA_DIR=/var/lib/write-pilot/data

# Daily snapshots of the data dir (the newest 14 are kept). Default ./.collab-backups
# WRITE_BACKUP_DIR=/var/backups/write-pilot

# Extra host names Vite accepts, comma-separated, after `.ts.net`. The pilot needs its Access hostname here.
# WRITE_ALLOWED_HOSTS=write.example.com

# Origins accepted for mutating requests and collaboration connections, besides the request's own
# Host. Only needed if something in front of the app rewrites the Host header.
# WRITE_ALLOWED_ORIGINS=https://write.example.com

# Access mode (required by `bun run preview`). The team domain is your Zero Trust team domain;
# the AUD is the Access application's "Application Audience (AUD) Tag".
# WRITE_ACCESS_TEAM_DOMAIN=acme.cloudflareaccess.com
# WRITE_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Where the signing keys are fetched from. Default https://<team domain>/cdn-cgi/access/certs.
# Only for tests that sign their own tokens; `iss` and `aud` are still checked. Must be https://,
# or http:// on loopback; when set, the startup line warns that the keys are not Cloudflare's.
# WRITE_ACCESS_CERTS_URL=

# Legacy owner: the user given every document created before per-user access.
# Default in dev: the dev identity. Required in preview if such documents exist.
# WRITE_OWNER_EMAIL=you@example.com

# Dev mode identity when the browser has no `write-dev-user` cookie. Default dev@localhost.
# Ignored in Access mode.
# WRITE_DEV_USER=you@example.com

# Download as PDF (GET /api/docs/:id/pdf) prints with Chromium's headless shell. Default: Playwright's
# own install for this checkout's playwright-core, from
#   ./node_modules/.bin/playwright-core install chromium-headless-shell
# (in ~/.cache/ms-playwright, or PLAYWRIGHT_BROWSERS_PATH). Without it the server still starts, logs
# one warning, and PDF downloads answer 503. Relative paths are relative to the project root.
# WRITE_PDF_CHROMIUM=/opt/write-pilot-chromium/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell

# PDF limits: exports printing at once (default 2), exports waiting for a turn (default 8; more get
# 503), the time for one export (default 30 s), and the largest document exported (default 25 MB,
# its stored state and the page made from it; larger gets 413).
# WRITE_PDF_MAX_CONCURRENT=2
# WRITE_PDF_MAX_QUEUE=8
# WRITE_PDF_TIMEOUT_SECONDS=30
# WRITE_PDF_MAX_MB=25
